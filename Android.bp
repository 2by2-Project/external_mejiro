prebuilt_font {
    name: "Mejiro-Thin.ttf",
    src: "prebuilt/Mejiro-Thin.ttf",
    product_specific: true,
}

prebuilt_font {
    name: "Mejiro-Light.ttf",
    src: "prebuilt/Mejiro-Light.ttf",
    product_specific: true,
}

prebuilt_font {
    name: "Mejiro-Regular.ttf",
    src: "prebuilt/Mejiro-Regular.ttf",
    product_specific: true,
}

prebuilt_font {
    name: "Mejiro-Semibold.ttf",
    src: "prebuilt/Mejiro-Semibold.ttf",
    product_specific: true,
}

prebuilt_font {
    name: "Mejiro-Bold.ttf",
    src: "prebuilt/Mejiro-Bold.ttf",
    product_specific: true,
}

prebuilt_font {
    name: "Mejiro-Extrabold.ttf",
    src: "prebuilt/Mejiro-Extrabold.ttf",
    product_specific: true,
}

filegroup {
    name: "mejiro",
    srcs: ["font_config.json"],
    required: [
        "Mejiro-Thin.ttf",
        "Mejiro-Light.ttf",
        "Mejiro-Regular.ttf",
        "Mejiro-Semibold.ttf",
        "Mejiro-Bold.ttf",
        "Mejiro-Extrabold.ttf",
    ],
}
